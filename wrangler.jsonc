{
    "name": "mev-kine",
    "compatibility_date": "2026-07-29",
    "main": "./worker/index.ts",
    "assets": {
      "directory": "./dist",
      "binding": "ASSETS",
      "run_worker_first": true
    },
    "routes": [
      {
        "pattern": "kinemev.cl",
        "custom_domain": true
      },
      {
        "pattern": "www.kinemev.cl",
        "custom_domain": true
      }
    ]
  }
