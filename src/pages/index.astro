---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { getServicePath, services } from "../data/services";
import { createWhatsAppUrl } from "../utils/contact";

const title = "KINE MEV | Kinesiología a domicilio en Santiago";
const description = "Atención kinesiológica personalizada a domicilio en Santiago para recuperar movilidad, función y autonomía.";
const whatsappUrl = createWhatsAppUrl("Hola, quiero agendar una evaluación kinesiológica.");
const googleReviewUrl = import.meta.env.PUBLIC_GOOGLE_REVIEW_URL?.trim();
const faqItems = [
  { q: "¿Cuándo veré resultados?", a: "Algunas personas notan cambios desde las primeras sesiones. Los tiempos dependen de la condición, los objetivos y la respuesta al tratamiento." },
  { q: "¿Las sesiones son personalizadas?", a: "Sí. La evaluación, los objetivos y cada sesión se adaptan a tu condición y a las actividades que necesitas recuperar." },
  { q: "¿Debo tener orden médica?", a: "No siempre. Puedes comenzar con una evaluación kinésica y presentar tus exámenes o indicaciones médicas si los tienes." },
];
---

<BaseLayout title={title} description={description} image="/kinesiologia_home_hero.png" faqItems={faqItems}>
  <section class="bg-secondary/30 py-10 md:py-16 lg:py-20">
    <div class="site-container grid min-w-0 items-center gap-9 lg:grid-cols-[1.08fr_.92fr] lg:gap-14">
      <div class="min-w-0 text-center lg:text-left">
        <p class="mb-3 text-sm font-bold uppercase text-primary">KINE MEV · Atención a domicilio</p>
        <h1 class="text-[2rem] font-bold leading-[1.08] text-foreground sm:text-4xl md:text-5xl lg:text-6xl">
          Elimina el dolor, recupera tu movilidad y vuelve a tu vida normal
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-muted-foreground lg:mx-0">
          Atención kinesiológica personalizada en Santiago, enfocada en objetivos reales desde la primera evaluación.
        </p>
        <div class="mt-7 grid gap-3 sm:flex sm:justify-center lg:justify-start">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-premium bg-[#1fa855] text-white hover:bg-[#168545]" data-analytics="whatsapp" data-location="hero">Agenda tu evaluación ahora</a>
          <a href="#tratamientos" class="btn-premium border border-primary/20 bg-white text-primary hover:bg-primary/5">Ver tratamientos</a>
        </div>

        <div class="mt-7 grid gap-2 border-t border-primary/10 pt-5 text-left text-sm font-semibold sm:grid-cols-3">
          {["Atención personalizada", "Resultados progresivos", "Enfoque basado en evidencia"].map((item) => (
            <p class="flex items-center gap-2"><span class="text-primary" aria-hidden="true">✓</span>{item}</p>
          ))}
        </div>
      </div>

      <figure class="relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-2xl bg-muted shadow-[var(--shadow-raised)]">
        <img src="/kinesiologia_home_hero.png" alt="Atención de kinesiología a domicilio" class="h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" width="900" height="1125" />
        <figcaption class="absolute inset-x-4 bottom-4 rounded-xl bg-white/95 p-4 shadow-[var(--shadow-soft)]">
          <strong class="block text-primary">Klgo. Jeremy Mancilla</strong>
          <span class="text-sm text-muted-foreground">Rehabilitación personalizada a domicilio</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section-space bg-white">
    <div class="site-container grid gap-10 lg:grid-cols-2 lg:items-center">
      <SectionHeading eyebrow="Evaluación oportuna" title="Sabemos lo que estás pasando" description="Dolor constante, dificultad para moverte y miedo a empeorar pueden limitar tu vida diaria. Postergar la recuperación suele prolongar esas restricciones." />
      <div class="border-l-4 border-primary bg-secondary/35 p-6 md:p-8">
        <p class="text-lg font-semibold leading-8">Con una evaluación adecuada podemos entender qué está limitando tus actividades y definir un tratamiento seguro, progresivo y acorde a tus objetivos.</p>
      </div>
    </div>
  </section>

  <section id="tratamientos" class="section-space scroll-mt-20 bg-background">
    <div class="site-container">
      <SectionHeading eyebrow="Especialidades" title="Tratamientos diseñados para tu recuperación" description="Tres áreas de atención, con un plan adaptado a tu condición, tu entorno y las actividades que necesitas recuperar." align="center" />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {services.map((service) => <ServiceCard title={service.shortTitle} description={service.description} href={getServicePath(service)} />)}
      </div>
    </div>
  </section>

  <section class="section-space bg-white">
    <div class="site-container grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
      <figure class="aspect-[4/3] overflow-hidden rounded-2xl bg-muted">
        <img src="/kinesiologia_about_me.png" alt="Kinesiólogo Jeremy Mancilla" class="h-full w-full object-cover" loading="lazy" decoding="async" width="900" height="675" />
      </figure>
      <div>
        <SectionHeading eyebrow="Sobre mí" title="Atención profesional, cercana y personalizada" description="Soy kinesiólogo enfocado en rehabilitación personalizada, con experiencia en lesiones, dolor persistente y recuperación funcional. Mi objetivo es ayudarte a recuperar calidad de vida de forma segura, progresiva y efectiva." />
        <p class="mt-5 leading-7 text-muted-foreground">Cuento con experiencia clínica y formación respiratoria, incluida certificación en sala IRA. Cada plan se construye a partir de una evaluación y se ajusta según tu progreso.</p>
        <ul class="mt-7 grid gap-3 sm:grid-cols-2">
          {["Atención 100% personalizada", "Seguimiento constante", "Objetivos funcionales", "Cercanía y compromiso"].map((item) => <li class="flex gap-2 font-semibold"><span class="text-primary">✓</span>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-space bg-secondary/30">
    <div class="site-container">
      <SectionHeading eyebrow="Proceso" title="Así será tu proceso" description="Te acompaño en cada etapa de tu recuperación." align="center" />
      <ol class="mt-12 grid gap-px overflow-hidden rounded-xl border border-primary/10 bg-primary/10 md:grid-cols-4">
        {["Evaluación completa", "Plan personalizado", "Tratamiento progresivo", "Seguimiento continuo"].map((step, index) => (
          <li class="min-w-0 bg-white p-6"><span class="text-sm font-bold text-primary">0{index + 1}</span><h3 class="mt-2 text-lg font-bold">{step}</h3></li>
        ))}
      </ol>
    </div>
  </section>

  {googleReviewUrl && (
    <section class="section-space bg-white">
      <div class="site-container flex max-w-4xl flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <SectionHeading eyebrow="Experiencias" title="Pacientes que ya comenzaron su recuperación" description="Tu experiencia puede ayudar a otras personas a tomar una decisión informada sobre su rehabilitación." />
        <a href={googleReviewUrl} target="_blank" rel="noopener noreferrer" class="btn-premium shrink-0 bg-primary text-white hover:bg-primary/90" data-analytics="review">Dejar una reseña</a>
      </div>
    </section>
  )}

  <section class="section-space bg-white">
    <div class="site-container max-w-4xl">
      <SectionHeading eyebrow="Resolvemos tus dudas" title="Preguntas frecuentes" />
      <div class="mt-8"><FaqList items={faqItems} /></div>
    </div>
  </section>

  <section class="bg-primary py-16 text-white md:py-20">
    <div class="site-container max-w-4xl text-center">
      <h2 class="text-3xl font-bold md:text-5xl">No sigas viviendo con dolor</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-white/80">Mientras antes evalúes la causa de tus limitaciones, antes podrás comenzar un plan de recuperación adecuado.</p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-premium bg-white text-primary hover:bg-secondary" data-analytics="whatsapp" data-location="home-final">Escríbeme y te oriento hoy</a>
        <a href="/contacto/#formulario" class="btn-premium border border-white/40 text-white hover:bg-white/10">Usar formulario</a>
      </div>
    </div>
  </section>
</BaseLayout>
