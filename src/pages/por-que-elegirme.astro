---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { createWhatsAppUrl } from "../utils/contact";
const title = "Sobre mí | Klgo. Jeremy Mancilla - KINE MEV";
const description = "Conoce la formación, experiencia y enfoque de atención personalizada del kinesiólogo Jeremy Mancilla en Santiago.";
---

<BaseLayout title={title} description={description} image="/kinesiologia_about_me.png">
  <section class="section-space bg-background">
    <div class="site-container grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <figure class="aspect-[4/5] max-h-[650px] overflow-hidden rounded-2xl bg-muted shadow-[var(--shadow-soft)]"><img src="/kinesiologia_about_me.png" alt="Kinesiólogo Jeremy Mancilla" class="h-full w-full object-cover" width="800" height="1000" decoding="async" /></figure>
      <div>
        <p class="mb-3 text-sm font-bold uppercase text-primary">Klgo. Jeremy Mancilla</p>
        <h1 class="text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">Rehabilitación que se adapta a tu vida</h1>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">Mi trabajo comienza por comprender qué necesitas recuperar y cómo tus síntomas afectan tus actividades cotidianas. A partir de esa evaluación definimos objetivos claros y un plan progresivo.</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="border-l-2 border-primary pl-5"><h2 class="text-xl font-bold">Formación clínica</h2><p class="mt-2 leading-7 text-muted-foreground">Experiencia en rehabilitación musculoesquelética, neurológica y respiratoria, con certificación en sala IRA.</p></div>
          <div class="border-l-2 border-primary pl-5"><h2 class="text-xl font-bold">Atención a domicilio</h2><p class="mt-2 leading-7 text-muted-foreground">El tratamiento se integra a tu entorno real y a las tareas que forman parte de tu rutina.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space bg-secondary/30">
    <div class="site-container">
      <SectionHeading eyebrow="Mi enfoque" title="Criterios que guían cada tratamiento" align="center" />
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <article class="border-t-2 border-primary bg-white p-7"><h2 class="text-2xl font-bold">Misión</h2><p class="mt-3 leading-7 text-muted-foreground">Entregar atención kinesiológica cercana, responsable y basada en evaluación, con planes comprensibles y relevantes para cada paciente.</p></article>
        <article class="border-t-2 border-accent bg-white p-7"><h2 class="text-2xl font-bold">Visión</h2><p class="mt-3 leading-7 text-muted-foreground">Facilitar el acceso a rehabilitación de calidad en el hogar y acompañar recuperaciones que se traduzcan en mayor autonomía.</p></article>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 text-center md:py-20">
    <div class="site-container max-w-3xl"><h2 class="text-3xl font-bold md:text-4xl">Tu recuperación comienza con una evaluación</h2><p class="mt-4 text-lg text-muted-foreground">Conversemos sobre tus objetivos y revisemos qué alternativa se ajusta a tu caso.</p><a href={createWhatsAppUrl("Hola, quiero agendar una evaluación kinesiológica.")} target="_blank" rel="noopener noreferrer" class="btn-premium mt-7 bg-primary text-white" data-analytics="whatsapp" data-location="about-final">Agendar evaluación</a></div>
  </section>
</BaseLayout>
