---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqList from "../components/FaqList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { services } from "../data/services";

const title = "Contacto y agendamiento | KINE MEV";
const description = "Agenda una evaluación de kinesiología a domicilio en Santiago por WhatsApp o mediante el formulario de contacto.";
const faqItems = [
  { q: "¿Qué necesito para la primera sesión?", a: "Ropa cómoda y los exámenes o indicaciones médicas que tengas disponibles." },
  { q: "¿Atiendes urgencias?", a: "La atención domiciliaria no reemplaza un servicio de urgencia. Ante signos de alarma debes acudir al centro asistencial correspondiente." },
];
---

<BaseLayout title={title} description={description} image="/contacto.png" faqItems={faqItems}>
  <section class="section-space bg-background">
    <div class="site-container grid gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
      <div>
        <p class="mb-3 text-sm font-bold uppercase text-primary">Contacto directo</p>
        <h1 class="text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">Hablemos de tu recuperación</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">Cuéntame qué te está pasando. Puedo orientarte y ofrecerte horarios disponibles para una evaluación a domicilio.</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          <a href="https://wa.me/56936319077?text=Hola%2C%20quiero%20agendar%20una%20evaluaci%C3%B3n%20kinesiol%C3%B3gica." target="_blank" rel="noopener noreferrer" data-analytics="whatsapp" data-location="contact-primary" class="rounded-xl bg-[#1fa855] p-5 text-white transition-colors hover:bg-[#168545]"><span class="block text-sm font-semibold text-white/80">WhatsApp directo</span><strong class="mt-1 block text-lg">+56 9 3631 9077</strong></a>
          <a href="mailto:Klgo.jeremymancilla@gmail.com" data-analytics="email" class="min-w-0 rounded-xl border border-primary/15 bg-white p-5"><span class="block text-sm font-semibold text-muted-foreground">Correo electrónico</span><strong class="mt-1 block break-all text-sm sm:text-base">Klgo.jeremymancilla@gmail.com</strong></a>
        </div>
      </div>
      <div>
        <FaqList items={faqItems} />
        <figure class="mt-7 aspect-[16/8] overflow-hidden rounded-xl bg-muted"><img src="/contacto.png" alt="Equipamiento para atención kinesiológica" class="h-full w-full object-cover" loading="lazy" decoding="async" width="900" height="450" /></figure>
      </div>
    </div>
  </section>

  <section id="formulario" class="section-space scroll-mt-20 bg-secondary/30">
    <div class="site-container max-w-3xl">
      <SectionHeading eyebrow="Contacto guiado" title="Cuéntanos qué necesitas" description="Completa estos datos para preparar un mensaje y continuar por WhatsApp. El sitio no almacena la información." align="center" />
      <form id="whatsapp-contact-form" class="mt-10 space-y-6 rounded-xl border border-primary/10 bg-white p-6 shadow-[var(--shadow-soft)] md:p-8" novalidate>
        <div class="grid gap-6 md:grid-cols-2">
          <label class="text-sm font-bold">Nombre<input name="name" type="text" autocomplete="name" required maxlength="80" class="mt-2 min-h-12 w-full rounded-lg border border-primary/20 bg-background px-4 font-normal outline-none focus:border-primary" /><span class="field-error mt-1 hidden text-xs text-destructive">Ingresa tu nombre.</span></label>
          <label class="text-sm font-bold">Servicio de interés<select name="service" required class="mt-2 min-h-12 w-full rounded-lg border border-primary/20 bg-background px-4 font-normal outline-none focus:border-primary"><option value="">Selecciona un servicio</option>{services.map((service) => <option value={service.slug}>{service.shortTitle}</option>)}<option value="orientacion-general">No estoy seguro/a</option></select><span class="field-error mt-1 hidden text-xs text-destructive">Selecciona una opción.</span></label>
          <label class="text-sm font-bold">Comuna<input name="commune" type="text" autocomplete="address-level2" required maxlength="80" class="mt-2 min-h-12 w-full rounded-lg border border-primary/20 bg-background px-4 font-normal outline-none focus:border-primary" /><span class="field-error mt-1 hidden text-xs text-destructive">Ingresa tu comuna.</span></label>
          <label class="text-sm font-bold">Horario preferido <span class="font-normal text-muted-foreground">(opcional)</span><input name="schedule" type="text" maxlength="100" placeholder="Ej. lunes por la tarde" class="mt-2 min-h-12 w-full rounded-lg border border-primary/20 bg-background px-4 font-normal outline-none focus:border-primary" /></label>
        </div>
        <label class="block text-sm font-bold">Mensaje breve <span class="font-normal text-muted-foreground">(opcional)</span><textarea name="message" rows="4" maxlength="500" class="mt-2 w-full resize-y rounded-lg border border-primary/20 bg-background p-4 font-normal outline-none focus:border-primary"></textarea></label>
        <label class="flex items-start gap-3 text-sm text-muted-foreground"><input name="privacy" type="checkbox" required class="mt-1 h-4 w-4 accent-primary" /><span>Entiendo que estos datos solo se usarán para construir el mensaje que enviaré por WhatsApp.</span></label>
        <span id="privacy-error" class="field-error hidden text-xs text-destructive">Debes aceptar esta condición para continuar.</span>
        <p id="form-status" class="hidden rounded-lg bg-primary/10 p-3 text-sm font-semibold text-primary" role="status" tabindex="-1"></p>
        <button type="submit" class="btn-premium w-full bg-[#1fa855] text-white hover:bg-[#168545] md:w-auto" data-location="contact-form">Preparar mensaje de WhatsApp</button>
      </form>
    </div>
  </section>

  <section class="section-space bg-white">
    <div class="site-container text-center">
      <SectionHeading eyebrow="Cobertura" title="Atención a domicilio en la Región Metropolitana" description="La disponibilidad y el recargo de traslado dependen de la comuna. Confirma tu dirección antes de reservar." align="center" />
      <div class="mx-auto mt-8 flex max-w-4xl flex-wrap justify-center gap-2">{["El Bosque", "La Cisterna", "San Bernardo", "La Florida", "Puente Alto", "Santiago", "Ñuñoa", "Las Condes"].map((commune) => <span class="rounded-full border border-primary/15 px-4 py-2 text-sm font-semibold">{commune}</span>)}</div>
    </div>
  </section>

  <script>
    import { createWhatsAppUrl } from "../utils/contact";
    const form = document.querySelector<HTMLFormElement>("#whatsapp-contact-form");
    const status = document.querySelector<HTMLElement>("#form-status");
    let started = false;
    const serviceSelect = form?.elements.namedItem("service") as HTMLSelectElement | null;
    const requestedService = new URLSearchParams(location.search).get("servicio");
    if (requestedService && serviceSelect?.querySelector(`option[value="${CSS.escape(requestedService)}"]`)) serviceSelect.value = requestedService;

    const showFieldState = (field: HTMLInputElement | HTMLSelectElement) => {
      const error = field.name === "privacy" ? document.getElementById("privacy-error") : field.closest("label")?.querySelector(".field-error");
      error?.classList.toggle("hidden", field.validity.valid);
      field.setAttribute("aria-invalid", String(!field.validity.valid));
    };
    form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]").forEach((field) => field.addEventListener("input", () => showFieldState(field)));
    form?.addEventListener("input", () => { if (!started) { started = true; window.kineTrack?.("form_start", { form_name: "whatsapp_contact" }); } });
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const required = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[required]")];
      required.forEach(showFieldState);
      const invalid = required.find((field) => !field.validity.valid);
      if (invalid) { invalid.focus(); window.kineTrack?.("form_validation_error", { form_name: "whatsapp_contact" }); return; }
      const data = new FormData(form);
      const service = String(data.get("service") || "");
      const lines = [`Hola, mi nombre es ${String(data.get("name") || "").trim()}.`, `Quiero consultar por: ${serviceSelect?.selectedOptions[0]?.textContent}.`, `Comuna: ${String(data.get("commune") || "").trim()}.`];
      if (data.get("schedule")) lines.push(`Horario preferido: ${data.get("schedule")}.`);
      if (data.get("message")) lines.push(`Comentario: ${data.get("message")}`);
      status!.textContent = "Mensaje preparado. Abriremos WhatsApp para que puedas revisarlo y enviarlo.";
      status?.classList.remove("hidden"); status?.focus();
      window.kineTrack?.("generate_lead", { method: "whatsapp_form", service });
      setTimeout(() => window.open(createWhatsAppUrl(lines.join("\n")), "_blank", "noopener,noreferrer"), 350);
    });
  </script>
</BaseLayout>
