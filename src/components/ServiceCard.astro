---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
  image?: string;
}
const { title, description, href, image, label = "Conocer tratamiento" } = Astro.props;
---

<article class="flex min-w-0 flex-col overflow-hidden border-t-2 border-primary bg-white shadow-[var(--shadow-soft)]">
  {image && <img src={image} alt="" class="aspect-[4/3] w-full object-cover" loading="lazy" decoding="async" width="738" height="1600" />}
  <div class="flex flex-1 flex-col p-6 md:p-7">
    <h3 class="text-xl font-bold md:text-2xl">{title}</h3>
    <p class="mt-3 flex-1 leading-7 text-muted-foreground">{description}</p>
    <a href={href} class="mt-6 inline-flex min-h-11 items-center gap-2 self-start font-bold text-primary hover:underline">
      {label}<span aria-hidden="true">→</span>
    </a>
  </div>
</article>
