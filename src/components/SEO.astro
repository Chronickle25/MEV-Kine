---
interface FaqItem { q: string; a: string }
interface BreadcrumbItem { name: string; url: string }
interface ServiceInfo { title: string; description: string; slug: string; image: string }

interface Props {
  siteUrl?: string;
  pageUrl?: string;
  title: string;
  description: string;
  imageUrl?: string;
  faqItems?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  service?: ServiceInfo;
}

const {
  siteUrl = "https://kinemev.cl",
  pageUrl = siteUrl,
  title,
  description,
  imageUrl = `${siteUrl}/kinesiologia_home_hero.png`,
  faqItems = [],
  breadcrumbs = [],
  service,
} = Astro.props;

const absoluteUrl = (url: string) => new URL(url, `${siteUrl}/`).toString();
const graph: Record<string, unknown>[] = [
  {
    "@type": "MedicalBusiness",
    "@id": `${siteUrl}/#business`,
    name: "KINE MEV - Kinesiología a Domicilio",
    alternateName: "Movimiento Es Vida Kinesiología",
    url: siteUrl,
    logo: absoluteUrl("/logo/icon-512.png"),
    image: imageUrl,
    telephone: "+56936319077",
    email: "Klgo.jeremymancilla@gmail.com",
    description: "Servicios de kinesiología a domicilio en Santiago y la Región Metropolitana.",
    priceRange: "$$",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Psj. San Alejandro I 1877",
      addressLocality: "El Bosque",
      addressRegion: "Región Metropolitana",
      postalCode: "8010000",
      addressCountry: "CL",
    },
    geo: { "@type": "GeoCoordinates", latitude: -33.5667, longitude: -70.6667 },
    openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Wednesday", "Friday"], opens: "09:00", closes: "20:00" }],
    areaServed: ["Santiago", "El Bosque", "La Cisterna", "San Bernardo", "San Ramón", "La Pintana", "Puente Alto", "La Florida", "San Miguel", "Ñuñoa", "Providencia", "Las Condes", "Vitacura"],
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "KINE MEV",
    inLanguage: "es-CL",
    publisher: { "@id": `${siteUrl}/#business` },
  },
  {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "es-CL",
    isPartOf: { "@id": `${siteUrl}/#website` },
    about: { "@id": `${siteUrl}/#business` },
    ...(breadcrumbs.length ? { breadcrumb: { "@id": `${pageUrl}#breadcrumb` } } : {}),
  },
];

if (breadcrumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: absoluteUrl(item.url) })),
  });
}

if (service) {
  graph.push({
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.title,
    description: service.description,
    image: absoluteUrl(service.image),
    url: pageUrl,
    serviceType: service.title,
    provider: { "@id": `${siteUrl}/#business` },
    areaServed: { "@type": "AdministrativeArea", name: "Región Metropolitana de Santiago" },
  });
}

if (faqItems.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })),
  });
}

const schema = { "@context": "https://schema.org", "@graph": graph };
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
