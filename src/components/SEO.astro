---
interface FaqItem { q: string; a: string }
interface BreadcrumbItem { name: string; url: string }
interface ServiceInfo { title: string; description: string; slug: string; image: string }
import { practitioner, serviceAreas } from "../data/practitioner";

interface Props {
  siteUrl?: string;
  pageUrl?: string;
  title: string;
  description: string;
  imageUrl?: string;
  faqItems?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  service?: ServiceInfo;
  pageType?: "WebPage" | "MedicalWebPage" | "ProfilePage";
  dateModified?: string;
}

const {
  siteUrl = "https://kinemev.cl",
  pageUrl = siteUrl,
  title,
  description,
  imageUrl = `${siteUrl}/kine-jeremy-mancilla.jpg`,
  faqItems = [],
  breadcrumbs = [],
  service,
  pageType = "WebPage",
  dateModified,
} = Astro.props;

const absoluteUrl = (url: string) => new URL(url, `${siteUrl}/`).toString();
const personId = `${siteUrl}/#practitioner`;
const organizationId = `${siteUrl}/#organization`;
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: "KINE MEV",
    alternateName: "Movimiento Es Vida",
    url: siteUrl,
    logo: absoluteUrl("/logo/icon-512.png"),
    image: imageUrl,
    telephone: "+56936319077",
    email: "Klgo.jeremymancilla@gmail.com",
    description: "Servicios de kinesiología a domicilio en Santiago y la Región Metropolitana.",
    priceRange: "$$",
    areaServed: serviceAreas.map((name) => ({ "@type": "AdministrativeArea", name })),
    founder: { "@id": personId },
    contactPoint: { "@type": "ContactPoint", telephone: "+56936319077", contactType: "appointments", availableLanguage: "Spanish" },
    ...(practitioner.sameAs?.length ? { sameAs: practitioner.sameAs } : {}),
  },
  {
    "@type": "Person",
    "@id": personId,
    name: practitioner.name,
    jobTitle: practitioner.jobTitle,
    worksFor: { "@id": organizationId },
    image: absoluteUrl("/kine-jeremy-mancilla.jpg"),
    knowsAbout: ["Kinesiología musculoesquelética", "Kinesiología respiratoria", "Kinesiología neurológica", "Rehabilitación a domicilio"],
    ...(practitioner.university ? { alumniOf: { "@type": "CollegeOrUniversity", name: practitioner.university } } : {}),
    ...(practitioner.registrationUrl ? { sameAs: [practitioner.registrationUrl, ...(practitioner.sameAs ?? [])] } : practitioner.sameAs?.length ? { sameAs: practitioner.sameAs } : {}),
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "KINE MEV",
    inLanguage: "es-CL",
    publisher: { "@id": organizationId },
  },
  {
    "@type": pageType,
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: title,
    description,
    inLanguage: "es-CL",
    isPartOf: { "@id": `${siteUrl}/#website` },
    about: { "@id": organizationId },
    ...(dateModified ? { dateModified, lastReviewed: dateModified } : {}),
    ...(pageType === "MedicalWebPage" ? { reviewedBy: { "@id": personId } } : {}),
    ...(pageType === "ProfilePage" ? { mainEntity: { "@id": personId } } : {}),
    ...(breadcrumbs.length ? { breadcrumb: { "@id": `${pageUrl}#breadcrumb` } } : {}),
  },
];

if (breadcrumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: absoluteUrl(item.url) })),
  });
}

if (service) {
  graph.push({
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.title,
    description: service.description,
    image: absoluteUrl(service.image),
    url: pageUrl,
    serviceType: service.title,
    provider: { "@id": organizationId },
    areaServed: serviceAreas.map((name) => ({ "@type": "AdministrativeArea", name })),
  });
}

if (faqItems.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: faqItems.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })),
  });
}

const schema = { "@context": "https://schema.org", "@graph": graph };
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
