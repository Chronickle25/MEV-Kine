---
interface Props { gtmId?: string }
const { gtmId = "" } = Astro.props;
const analyticsScript = gtmId ? `
(function () {
  var STORAGE_KEY = "kine_mev_consent";
  window.dataLayer = window.dataLayer || [];
  window.gtag = function(){ window.dataLayer.push(arguments); };
  window.gtag("consent", "default", {
    analytics_storage: "denied",
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    wait_for_update: 500
  });

  function loadGtm() {
    if (document.getElementById("kine-gtm-script")) return;
    var script = document.createElement("script");
    script.id = "kine-gtm-script";
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtm.js?id=${gtmId}";
    document.head.appendChild(script);
  }

  window.kineSetConsent = function(value) {
    localStorage.setItem(STORAGE_KEY, value);
    var granted = value === "accepted";
    window.gtag("consent", "update", {
      analytics_storage: granted ? "granted" : "denied",
      ad_storage: granted ? "granted" : "denied",
      ad_user_data: granted ? "granted" : "denied",
      ad_personalization: granted ? "granted" : "denied"
    });
    if (granted) loadGtm();
    window.dispatchEvent(new CustomEvent("kine-consent-change", { detail: value }));
  };

  window.kineTrack = function(eventName, parameters) {
    if (localStorage.getItem(STORAGE_KEY) !== "accepted") return;
    window.dataLayer.push(Object.assign({ event: eventName }, parameters || {}));
  };

  if (localStorage.getItem(STORAGE_KEY) === "accepted") {
    window.gtag("consent", "update", { analytics_storage: "granted", ad_storage: "granted", ad_user_data: "granted", ad_personalization: "granted" });
    loadGtm();
  }
})();` : "";
---
{gtmId && <script is:inline set:html={analyticsScript} />}

