---
import { practitioner } from "../data/practitioner";
interface Props { reviewedAt: string }
const { reviewedAt } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("es-CL", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${reviewedAt}T00:00:00Z`));
---

<aside class="rounded-xl border border-primary/15 bg-secondary/25 p-5" aria-label="Revisión clínica">
  <div class="flex items-center gap-4">
    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white" aria-hidden="true">JM</span>
    <div>
      <p class="text-sm text-muted-foreground">Contenido revisado por</p>
      <a href="/por-que-elegirme/" rel="author" class="font-bold text-primary hover:underline">{practitioner.jobTitle} {practitioner.name}</a>
      <p class="text-sm text-muted-foreground">Última revisión: <time datetime={reviewedAt}>{formattedDate}</time></p>
    </div>
  </div>
</aside>
