---
interface Props { enabled?: boolean }
const { enabled = false } = Astro.props;
---

{enabled && (
  <>
    <section id="consent-banner" class="hidden fixed inset-x-4 bottom-4 z-[100] max-w-3xl mx-auto bg-white border border-primary/20 shadow-[var(--shadow-raised)] rounded-xl p-5 md:p-6" aria-label="Preferencias de privacidad" aria-live="polite">
      <div class="md:flex items-center gap-6">
        <p class="text-sm text-muted-foreground leading-relaxed flex-1">Usamos analítica para entender qué contenidos ayudan a nuestros visitantes. Puedes aceptar o rechazar esta medición; tu elección se puede cambiar después.</p>
        <div class="flex gap-3 mt-4 md:mt-0 shrink-0">
          <button type="button" data-consent="rejected" class="px-4 py-2.5 rounded-xl border border-primary/20 font-bold text-sm text-primary">Rechazar</button>
          <button type="button" data-consent="accepted" class="px-4 py-2.5 rounded-xl bg-primary text-white font-bold text-sm">Aceptar</button>
        </div>
      </div>
    </section>
    <button id="privacy-settings" type="button" class="hidden fixed left-4 bottom-4 z-[90] bg-white border border-primary/20 shadow-lg rounded-full px-4 py-2 text-xs font-bold text-primary">Privacidad</button>
    <script>
      const key = "kine_mev_consent";
      const banner = document.getElementById("consent-banner");
      const settings = document.getElementById("privacy-settings");
      const refresh = () => {
        const choice = localStorage.getItem(key);
        const visible = !choice;
        banner?.classList.toggle("hidden", !visible);
        settings?.classList.toggle("hidden", !choice);
        window.dispatchEvent(new CustomEvent("kine-consent-visibility", { detail: { visible } }));
      };
      banner?.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((button) => button.addEventListener("click", () => {
        window.kineSetConsent?.(button.dataset.consent === "accepted" ? "accepted" : "rejected");
        refresh();
      }));
      settings?.addEventListener("click", () => {
        window.kineSetConsent?.("rejected");
        localStorage.removeItem(key);
        refresh();
      });
      refresh();
    </script>
  </>
)}
