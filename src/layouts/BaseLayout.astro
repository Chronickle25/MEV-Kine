---
import "../styles/globals.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingActions from "../components/FloatingActions.astro";
import SEO from "../components/SEO.astro";
import AnalyticsHead from "../components/AnalyticsHead.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface BreadcrumbItem { name: string; url: string }
interface ServiceInfo { title: string; description: string; slug: string; image: string }

interface Props {
	title?: string;
	description?: string;
	image?: string;
	faqItems?: { q: string; a: string }[];
	breadcrumbs?: BreadcrumbItem[];
	service?: ServiceInfo;
}

const { 
	title = "KINE MEV - Kinesiología a Domicilio en Santiago | Región Metropolitana",
	description = "Servicios profesionales de kinesiología a domicilio en Santiago. Especialista en neurología, respiratoria y musculoesquelética para todas las edades.",
	image = "/kinesiologia_home_hero.png",
	faqItems = [],
	breadcrumbs = [],
	service,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://kinemev.cl";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim();
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="es" class="font-sans antialiased scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<AnalyticsHead gtmId={gtmId} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="192x192" href="/logo/icon-192.png" />
		<link rel="apple-touch-icon" sizes="192x192" href="/logo/icon-192.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#062b55" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index,follow" />
		{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
		<link rel="canonical" href={canonicalUrl} />
		
		<!-- SEO Meta Tags -->
		<meta name="geo.region" content="CL-RM" />
		<meta name="geo.placename" content="Santiago" />
		<meta name="geo.position" content="-33.4489;-70.6693" />
		<meta name="ICBM" content="-33.4489, -70.6693" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="es_CL" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageUrl} />
		<meta property="twitter:image:alt" content={title} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
		<noscript><style>.reveal{opacity:1;transform:none}</style></noscript>
		<SEO siteUrl={siteUrl} pageUrl={canonicalUrl} title={title} description={description} imageUrl={imageUrl} faqItems={faqItems} breadcrumbs={breadcrumbs} service={service} />
	</head>
	<body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/10 selection:text-primary" data-service={service?.slug}>
		<a href="#main-content" class="fixed left-4 top-3 z-[110] -translate-y-20 rounded-lg bg-foreground px-4 py-3 font-bold text-white transition-transform focus:translate-y-0">Saltar al contenido</a>
		<Header />
		<main id="main-content" class="flex-1 min-w-0">
			<slot />
		</main>
		<Footer />
		<FloatingActions />
		<ConsentBanner enabled={Boolean(gtmId)} />

        <script>
            // 1. Reveal Elements on Scroll (Intersection Observer)
            const observerOptions = {
                root: null,
                threshold: 0.1,
                rootMargin: "0px 0px -50px 0px"
            };

            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (prefersReducedMotion) {
                document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
            }

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            if (!prefersReducedMotion) {
                document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
            }

			document.addEventListener('click', (event) => {
				const clicked = (event.target as HTMLElement).closest<HTMLElement>('a, button');
				if (!clicked) return;
				const target = clicked.closest<HTMLElement>('[data-analytics]') || clicked;
				const kind = target.dataset.analytics;
				const href = target instanceof HTMLAnchorElement ? target.href : '';
				if (kind === 'whatsapp' || href.includes('wa.me/')) {
					window.kineTrack?.('whatsapp_click', { location: target.dataset.location || 'unknown', service: target.dataset.service || 'general', cta_text: target.textContent?.trim() || '' });
				}
				if (kind === 'service-select') {
					window.kineTrack?.('service_select', { service: target.dataset.service || 'unknown' });
				}
				if (kind === 'email' || href.startsWith('mailto:')) window.kineTrack?.('contact_email_click');
				if (kind === 'review') window.kineTrack?.('review_link_click');
			});

			let serviceViewSent = false;
			let priceViewSent = false;
			const trackServiceView = () => {
				const serviceSlug = document.body.dataset.service;
				const hasConsent = localStorage.getItem('kine_mev_consent') === 'accepted';
				if (serviceSlug && !serviceViewSent && hasConsent) {
					window.kineTrack?.('service_view', { service: serviceSlug });
					serviceViewSent = true;
				}
				if (window.location.pathname.startsWith('/precios') && !priceViewSent && hasConsent) {
					window.kineTrack?.('price_view');
					priceViewSent = true;
				}
			};
			trackServiceView();
			window.addEventListener('kine-consent-change', trackServiceView);
        </script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', sans-serif;
		--font-display: 'Outfit', sans-serif;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-display);
		letter-spacing: 0;
	}

	/* Smooth page transitions helper using native CSS */
	.page-content {
		animation: fadeUp 0.3s forwards ease-out;
		opacity: 0;
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
		}

		.page-content {
			animation: none;
			opacity: 1;
		}
	}
</style>
